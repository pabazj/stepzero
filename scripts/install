#!/bin/sh
# Symlink every stepzero skill into the agent skills directory.
# Safe to re-run: existing correct links are left alone, and nothing that
# already exists is ever overwritten or deleted.
#
# Usage: scripts/install
# Env:   STEPZERO_SKILLS_DIR  target dir (default: ~/.cursor/skills)
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
DEST=${STEPZERO_SKILLS_DIR:-"$HOME/.cursor/skills"}

mkdir -p "$DEST"
echo "Installing stepzero skills into $DEST"

conflicts=0
for dir in "$ROOT"/skills/*/; do
  src=${dir%/}
  [ -f "$src/SKILL.md" ] || continue
  name=$(basename "$src")
  target="$DEST/$name"

  if [ -L "$target" ]; then
    current=$(readlink "$target")
    if [ "$current" = "$src" ]; then
      echo "  ok      $name (already linked)"
    else
      echo "  CONFLICT $name: $target is a link to $current"
      echo "           Remove it and re-run to link to $src"
      conflicts=$((conflicts + 1))
    fi
  elif [ -e "$target" ]; then
    echo "  CONFLICT $name: $target exists and is not a symlink. Left untouched."
    conflicts=$((conflicts + 1))
  else
    ln -s "$src" "$target"
    echo "  linked  $name -> $src"
  fi
done

if [ "$conflicts" -gt 0 ]; then
  echo "Done with $conflicts conflict(s). Resolve them manually and re-run." >&2
  exit 1
fi
echo "Done. Update later with: git -C \"$ROOT\" pull (links pick up changes)."
